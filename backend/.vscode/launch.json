{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Suraksha API",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.api:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8001",
                "--reload"
            ],
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        },
        {
            "name": "Python: Train All Models",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/run_all_models.py",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run Integration Test",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/test_integration.py",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: GIS Export",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/gis_export.py",
            "justMyCode": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run API (no reload)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.api:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8001"
            ],
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            }
        }
    ]
}
